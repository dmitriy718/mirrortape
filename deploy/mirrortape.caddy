# Import this site into the existing Caddyfile after inspecting other hosted sites.
# First provision /etc/caddy/mirrortape-upstream.caddy with the verified active loopback upstream.
mirrortape.net {
	encode zstd gzip
	request_body {
		max_size 256KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		+Cache-Control "no-transform"
		-Server
	}
	@assets path /assets/*
	# Cloudflare ranges verified against its official IPv4/IPv6 lists on 2026-09-07.
	@cloudflare {
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		header CF-Connecting-IP *
	}
	route {
		vars mirrortape_client_ip {remote_host}
		vars @cloudflare mirrortape_client_ip {http.request.header.CF-Connecting-IP}
		handle @assets {
			root * /srv/mirrortape/shared
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			import /etc/caddy/mirrortape-upstream.caddy
		}
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				request>headers>Referer delete
				request>uri query {
					delete code
					delete state
					delete token
				}
			}
		}
	}
}
# Add a www redirect only after www DNS points to this server and TLS is verified.
