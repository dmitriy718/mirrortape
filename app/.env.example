# Copy to an ignored .env for local use; on the VPS use /etc/mirrortape/app.env (0600).
# Never put server credentials in VITE_* variables. Blank integrations remain unavailable.
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3100
DATABASE_URL=
# Generate SESSION_SECRET: openssl rand -hex 48
SESSION_SECRET=
# Generate ENCRYPTION_KEY: openssl rand -hex 32; back up securely, required to decrypt stored tokens.
ENCRYPTION_KEY=
TRUST_PROXY=false
RELEASE_ID=local
SMTP_URL=
MAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_ENABLED=false
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
ALPACA_COMMERCIAL_APPROVED=false
GOOGLE_PLACES_API_KEY=
# Leave zero unless there is an actual operationally limited cohort.
COHORT_CAPACITY=0
COHORT_END=
# Only trust this exact address when running behind the dedicated Docker gateway.
TRUST_PROXY_ADDRESS=
# Social providers: fill every setting in a provider group together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Base64-encoded Apple .p8 private key; never a frontend environment value.
APPLE_PRIVATE_KEY_BASE64=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Explicit version selected for the Meta application, e.g. v25.0; verify in its dashboard.
FACEBOOK_GRAPH_VERSION=
